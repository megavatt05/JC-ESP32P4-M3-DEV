# JC-ESP32P4-M3-DEV — ot_rcp для встроенного ESP32-C6
# Обязательно для Варианта A (Zigbee Gateway)
# ESP-IDF v5.5.x recommended

CONFIG_IDF_TARGET="esp32c6"

# ---------------------------------------------------------------------------
# OpenThread RCP — обязательно
# ---------------------------------------------------------------------------
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_RADIO=y
CONFIG_OPENTHREAD_RCP=y
CONFIG_OPENTHREAD_NCP_VENDOR_HOOK=y

# ---------------------------------------------------------------------------
# UART Spinel (по умолчанию UART0, 460800)
# При необходимости измените в menuconfig:
#   OpenThread RCP Example → Configure RCP UART pin manually
# ---------------------------------------------------------------------------
# CONFIG_OPENTHREAD_UART_PIN_MANUAL=y
# CONFIG_OPENTHREAD_UART_RX_PIN=...
# CONFIG_OPENTHREAD_UART_TX_PIN=...

# ---------------------------------------------------------------------------
# Размер прошивки (оптимизация)
# ---------------------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_OPENTHREAD_LOG_LEVEL_NONE=y

# ---------------------------------------------------------------------------
# Flash
# ---------------------------------------------------------------------------
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# На модуле C6 обычно 4/8 MB — смотрите фактический чип
