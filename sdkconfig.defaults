# JC1060 / JC-ESP32P4-M3-DEV — Zigbee Gateway
# Host: ESP32-P4 | Radio: ESP32-C6 as ot_rcp (Spinel UART)

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# PSRAM (JC1060 typically has OCT PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y

# Zigbee SDK 2.x on P4 (no native 802.15.4)
CONFIG_ZB_ENABLED=y
# CONFIG_ZB_SDK_1xx is not set
CONFIG_ZB_ZCZR=y
# CONFIG_ZB_RADIO_NATIVE is not set
CONFIG_ZB_RADIO_SPINEL_UART=y
CONFIG_OPENTHREAD_SPINEL_ONLY=y

CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_24=y
